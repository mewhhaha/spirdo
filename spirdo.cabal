cabal-version:      3.14
name:               spirdo
version:            0.2.0.0
synopsis:            WESL and WGSL to SPIR-V compiler with typed reflection
description:
    Spirdo compiles WESL and WGSL shaders to SPIR-V at runtime or with
    Template Haskell. It reflects shader stages, resources, overrides, and
    vertex inputs, and provides typed resource submission and uniform packing
    without coupling applications to a renderer.
homepage:            https://github.com/mewhhaha/spirdo
bug-reports:         https://github.com/mewhhaha/spirdo/issues
license:            MIT
license-file:       LICENSE
author:             mewhhaha
maintainer:         kopatheonlyone@hotmail.com
category:           Graphics
build-type:         Simple
tested-with:         GHC ==9.12.2 || ==9.14.1
extra-doc-files:
    README.md
    CHANGELOG.md
    MIGRATION.md
    PERF_REFACTOR_REPORT.md
    docs/*.md
extra-source-files:
    justfile
    bench/fixtures/*.wesl
    examples/cabal.project
    examples/spirdo-examples.cabal
    examples/app/*.hs
    examples/src/Examples/*.hs
    examples/src/Examples/Fragments/*.hs
    skills/use-spirdo/SKILL.md
    test/fixtures/*.wesl
    test/cts/positive/*.wesl
    test/cts/negative/*.wesl
    test/parity/fixtures/*.wesl
    test/parity/fixtures/cts_backlog/*.wgsl
    test/parity/manifest.tsv
    test/parity/rules.tsv
    test/parity/pins.json
    test/parity/cts_allowlist.tsv
    test/parity/cts_blocklist.tsv
    test/parity/generated/*.tsv
    scripts/parity/*.sh
    scripts/parity/*.py
    scripts/parity/*.hs
    test/golden/*.golden

common warnings
    ghc-options: -Wall
    default-extensions:
        DuplicateRecordFields
        DerivingStrategies
        DerivingVia
        NoFieldSelectors
        OverloadedRecordDot
        OverloadedStrings

library
    import:           warnings
    exposed-modules:
                     , Spirdo.Wesl
                     , Spirdo.Wesl.Inputs
                     , Spirdo.Wesl.Reflection
                     , Spirdo.Wesl.Uniform
    other-modules:
        Spirdo.Wesl.Types
        Spirdo.Wesl.Types.Interface
        Spirdo.Wesl.Types.Layout
        Spirdo.Wesl.Types.Uniform
        Spirdo.Wesl.Compiler
        Spirdo.Wesl.Compiler.Cache
        Spirdo.Wesl.SourceFile
        Spirdo.Wesl.Syntax
        Spirdo.Wesl.Util
        Spirdo.Wesl.Parser
        Spirdo.Wesl.Typecheck
        Spirdo.Wesl.Emit
        Spirdo.Wesl.Emit.Encoding
    -- other-extensions:
    build-depends:
        base >=4.21 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.7 && <0.9,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        time >=1.12 && <1.16,
        text >=2.1 && <2.2,
        transformers >=0.6 && <0.7,
        template-haskell >=2.23 && <2.25
    hs-source-dirs:   lib
    default-language: GHC2024

test-suite spirdo-tests
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    other-modules:
        CompilerCacheRegression
        EncodingRegression
        EmitSemanticRegression
        ImportSemanticRegression
        InputSafetyRegression
        LayoutConformanceRegression
        PackageResolutionRegression
        ParserRegression
        PublicApiRegression
        Spirdo.Test.Fixtures
        Spirdo.Test.Harness
        UniformSafetyRegression
    build-depends:
        base >=4.21 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.7 && <0.9,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        process >=1.6 && <1.7,
        QuickCheck >=2.14 && <2.17,
        text >=2.1 && <2.2,
        template-haskell >=2.23 && <2.25,
        spirdo
    default-language: GHC2024

benchmark spirdo-compile-bench
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          CompileBench.hs
    hs-source-dirs:   bench
    build-depends:
        base >=4.21 && <4.23,
        bytestring >=0.12 && <0.13,
        spirdo
    default-language: GHC2024

source-repository head
    type:     git
    location: https://github.com/mewhhaha/spirdo.git
