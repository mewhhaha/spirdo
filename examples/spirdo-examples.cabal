cabal-version:      3.14
name:               spirdo-examples
version:            0.2.0.0
synopsis:           Interactive GPU shader examples for Spirdo
description:
    Optional SDL GPU examples that render WESL and WGSL shaders compiled by
    Spirdo. The package includes a shader gallery and the Crystal Run 3D game,
    exercising fragment, vertex, compute, resource, and override workflows
    against a live GPU backend.
homepage:            https://github.com/mewhhaha/spirdo
bug-reports:         https://github.com/mewhhaha/spirdo/issues
license:            MIT
author:             mewhhaha
maintainer:         kopatheonlyone@hotmail.com
category:           Graphics
build-type:         Simple
tested-with:         GHC ==9.14.1

common warnings
    ghc-options: -Wall

executable spirdo-demo
    import:           warnings
    main-is:          Main.hs
    other-modules:
        Examples.Compute
        Examples.Fragments
        Examples.Fragments.CheckerWarp
        Examples.Fragments.CirclePulse
        Examples.Fragments.GradientBloom
        Examples.Fragments.InlineImports
        Examples.Fragments.Kaleidoscope
        Examples.Fragments.Metaballs
        Examples.Fragments.NoiseFlow
        Examples.Fragments.PlasmaStorm
        Examples.Fragments.RippleCaustics
        Examples.Fragments.SdfText
        Examples.Fragments.SineWaves
        Examples.Fragments.SpectrumShift
        Examples.Fragments.SwirlVortex
        Examples.Fragments.VignetteGlow
        Examples.Override
        Examples.Vertex
    build-depends:
        base >=4.21 && <4.23,
        bytestring >=0.12 && <0.13,
        slop >=0.1 && <0.2,
        spirdo >=0.2 && <0.3

    hs-source-dirs:   app, src
    default-language: GHC2024

executable spirdo-game
    import:           warnings
    main-is:          Game.hs
    other-modules:
        Examples.Game.Camera
        Examples.Game.Input
        Examples.Game.Logic
        Examples.Game.Meshes
        Examples.Game.Shaders
    build-depends:
        base >=4.21 && <4.23,
        slop >=0.1 && <0.2,
        spirdo >=0.2 && <0.3

    hs-source-dirs:   game, src
    default-language: GHC2024

test-suite spirdo-game-tests
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          GameLogicTest.hs
    other-modules:
        Examples.Game.Camera
        Examples.Game.Input
        Examples.Game.Logic
    build-depends:
        base >=4.21 && <4.23,
        slop >=0.1 && <0.2

    hs-source-dirs:   test, src
    default-language: GHC2024
