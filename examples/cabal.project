packages: .
          ../

with-compiler: ghc-9.14.1

-- Hackage package versions and revisions are fixed for repeatable CI solves.
index-state: 2026-07-01T00:00:00Z

-- Pin the demo backend to the reviewed Slop revision until it publishes a
-- compatible Hackage release.
source-repository-package
  type: git
  location: https://github.com/mewhhaha/slop
  tag: ff550dfeec4513f82d73642b150556c59090307e

-- The reviewed Slop revision predates base-4.22, but builds unchanged on it.
allow-newer: slop:base
